<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="cobra_arm">

  <xacro:include filename="$(find ur_description)/urdf/ur.urdf.xacro"/>

  <xacro:include filename="$(find robotiq_description)/urdf/ur_to_robotiq_adapter.urdf.xacro"/>
  <xacro:include filename="$(find arm_bringup)/urdf/robotiq_2f_85_damped_macro.urdf.xacro"/>

  <xacro:ur_to_robotiq prefix="" connected_to="tool0"/>

  <xacro:robotiq_gripper_damped name="robotiq_gripper" prefix="" parent="gripper_mount_link" joint_damping="2.0" joint_friction="0.5">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:robotiq_gripper_damped>

  <link name="camera_mount_link">
    <visual>
      <origin xyz="0 0 -0.005" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 0.01"/></geometry>
      <material name="mount_grey"><color rgba="0.2 0.2 0.2 1"/></material>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 -0.005"/>
      <inertia ixx="0.00002" iyy="0.00002" izz="0.00002" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="camera_mount_joint" type="fixed">
    <parent link="tool0"/>
    <child link="camera_mount_link"/>
    <origin xyz="0.06 0.0 -0.04" rpy="0 -1.2217304763960306 -1.5707963267948966"/>
  </joint>

  <xacro:include filename="$(find realsense2_description)/urdf/_d435.urdf.xacro"/>
  <xacro:sensor_d435 parent="camera_mount_link" name="d435" use_nominal_extrinsics="true">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:sensor_d435>

  <gazebo reference="d435_link">
    <sensor type="depth" name="d435">
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>1.211</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
      </camera>
      <plugin name="d435_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>camera</namespace>
          <remapping>d435/image_raw:=color/image_raw</remapping>
          <remapping>d435/camera_info:=color/camera_info</remapping>
          <remapping>d435/depth/image_raw:=depth/image_raw</remapping>
          <remapping>d435/depth/camera_info:=depth/camera_info</remapping>
          <remapping>d435/points:=depth/points</remapping>
        </ros>
        <camera_name>d435</camera_name>
        <frame_name>d435_color_optical_frame</frame_name>
        <min_depth>0.1</min_depth>
        <max_depth>3.0</max_depth>
      </plugin>
    </sensor>
  </gazebo>

</robot>
